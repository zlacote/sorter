<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the languages the app ships translations for. This is what lets
  Android 13 and later offer a per-app language entry in system settings, and
  it is also what an in-app picker writes to.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
</locale-config>
