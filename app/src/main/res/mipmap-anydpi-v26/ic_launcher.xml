<?xml version="1.0" encoding="utf-8"?>
<!--
  Two raster layers rather than one vector: the background is a radial wash and
  the mark is an antialiased outline, neither of which a path describes well.
  Keeping them split is what lets the launcher mask and parallax them on their
  own, which is the whole point of an adaptive icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>